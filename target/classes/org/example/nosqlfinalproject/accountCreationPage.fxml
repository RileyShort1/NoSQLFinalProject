<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/22"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.nosqlfinalproject.accountCreationController"
            style="-fx-background-color: linear-gradient(to bottom, #1f2933, #111827);">

    <children>
        <!-- Centered card -->
        <AnchorPane prefWidth="420.0" prefHeight="600.0"
                    layoutX="390.0" layoutY="100.0"
                    style="-fx-background-color: #f9fafb;
                           -fx-background-radius: 18;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.25), 20, 0.2, 0, 8);">

            <children>
                <VBox spacing="14.0" alignment="TOP_CENTER"
                      layoutX="40.0" layoutY="35.0"
                      prefWidth="340.0">

                    <!-- Title -->
                    <Label text="Create Account"
                           style="-fx-text-fill: #111827;">
                        <font>
                            <Font size="26.0" />
                        </font>
                    </Label>

                    <Label text="Join us by creating your account."
                           wrapText="true"
                           style="-fx-text-fill: #6b7280;">
                        <font>
                            <Font size="12.0" />
                        </font>
                    </Label>

                    <!-- First Name -->
                    <VBox spacing="6.0">
                        <Label text="First Name" style="-fx-text-fill: #374151;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="firstNameField"
                                   promptText="First Name"
                                   prefWidth="260.0"
                                   style="-fx-background-radius: 8;
                                          -fx-border-radius: 8;
                                          -fx-border-color: #e5e7eb;" />
                    </VBox>

                    <!-- Last Name -->
                    <VBox spacing="6.0">
                        <Label text="Last Name" style="-fx-text-fill: #374151;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="lastNameField"
                                   promptText="Last Name"
                                   prefWidth="260.0"
                                   style="-fx-background-radius: 8;
                                          -fx-border-radius: 8;
                                          -fx-border-color: #e5e7eb;" />
                    </VBox>

                    <!-- Email -->
                    <VBox spacing="6.0">
                        <Label text="Email" style="-fx-text-fill: #374151;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="emailField"
                                   promptText="Email"
                                   prefWidth="260.0"
                                   style="-fx-background-radius: 8;
                                          -fx-border-radius: 8;
                                          -fx-border-color: #e5e7eb;" />
                    </VBox>

                    <!-- Username -->
                    <VBox spacing="6.0">
                        <Label text="Username" style="-fx-text-fill: #374151;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <TextField fx:id="usernameField"
                                   promptText="Username"
                                   prefWidth="260.0"
                                   style="-fx-background-radius: 8;
                                          -fx-border-radius: 8;
                                          -fx-border-color: #e5e7eb;" />
                    </VBox>

                    <!-- Password -->
                    <VBox spacing="6.0">
                        <Label text="Password" style="-fx-text-fill: #374151;">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                        <PasswordField fx:id="passwordField"
                                       promptText="Password"
                                       prefWidth="260.0"
                                       style="-fx-background-radius: 8;
                                              -fx-border-radius: 8;
                                              -fx-border-color: #e5e7eb;" />
                    </VBox>

                    <!-- Buttons -->
                    <VBox spacing="10.0" alignment="CENTER"
                          prefWidth="340.0">
                        <padding>
                            <Insets top="16.0" bottom="0.0"/>
                        </padding>

                        <Button fx:id="createAccountSubmitButton"
                                text="Create Account"
                                onAction="#handleCreateAccount"
                                prefWidth="260.0" prefHeight="32.0"
                                style="-fx-background-color: #2563eb;
                                       -fx-text-fill: white;
                                       -fx-background-radius: 999;
                                       -fx-font-weight: bold;
                                       -fx-alignment: CENTER;" />

                        <Button text="Back to Login"
                                onAction="#goBackToLogin"
                                prefWidth="260.0" prefHeight="30.0"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #2563eb;
                                       -fx-background-radius: 999;
                                       -fx-border-color: #bfdbfe;
                                       -fx-border-radius: 999;
                                       -fx-alignment: CENTER;" />
                    </VBox>

                </VBox>
            </children>
        </AnchorPane>
    </children>
</AnchorPane>