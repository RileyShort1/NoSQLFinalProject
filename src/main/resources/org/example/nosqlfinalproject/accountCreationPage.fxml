<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.nosqlfinalproject.accountCreationController">
   <children>
      <Text layoutX="525.0" layoutY="180.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Create Account" wrappingWidth="200.0" />
      <Text layoutX="525.0" layoutY="230.0" strokeType="OUTSIDE" strokeWidth="0.0" text="First Name" />
      <TextField fx:id="firstNameField" layoutX="525.0" layoutY="235.0" prefWidth="200.0" />
      <Text layoutX="525.0" layoutY="280.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Last Name" />
      <TextField fx:id="lastNameField" layoutX="525.0" layoutY="285.0" prefWidth="200.0" />
      <Text layoutX="525.0" layoutY="330.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Email" />
      <TextField fx:id="emailField" layoutX="525.0" layoutY="335.0" prefWidth="200.0" />
      <Text layoutX="525.0" layoutY="380.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Username" />
      <TextField fx:id="usernameField" layoutX="525.0" layoutY="385.0" prefWidth="200.0" />
      <Text layoutX="525.0" layoutY="430.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password" />
      <PasswordField fx:id="passwordField" layoutX="525.0" layoutY="435.0" prefWidth="200.0" />
      <Button fx:id="createAccountSubmitButton" layoutX="525.0" layoutY="480.0" mnemonicParsing="false" onAction="#handleCreateAccount" prefHeight="26.0" prefWidth="200.0" text="Create Account" />
      <Button layoutX="525.0" layoutY="520.0" mnemonicParsing="false" onAction="#goBackToLogin" prefHeight="26.0" prefWidth="200.0" text="Back to Login" />
   </children>
</AnchorPane>

