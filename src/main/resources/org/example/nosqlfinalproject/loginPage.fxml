<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="800.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.nosqlfinalproject.loginPageController">
   <children>
      <Text layoutX="525.0" layoutY="200.0" strokeType="OUTSIDE" strokeWidth="0.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Login" />
      <Text layoutX="525.0" layoutY="230.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Name (First Last)" wrappingWidth="150.0" />
      <TextField fx:id="nameField" layoutX="525.0" layoutY="235.0" prefHeight="26.0" prefWidth="200.0" promptText="First Last" />
      <Text layoutX="525.0" layoutY="280.0" strokeType="OUTSIDE" strokeWidth="0.0" text="or Username" wrappingWidth="150.0" />
      <TextField fx:id="usernameField" layoutX="525.0" layoutY="285.0" prefHeight="26.0" prefWidth="200.0" promptText="Username" />
      <Text layoutX="525.0" layoutY="330.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Password" wrappingWidth="150.0" />
      <PasswordField fx:id="passwordField" layoutX="525.0" layoutY="335.0" prefHeight="26.0" prefWidth="200.0" promptText="Password" />
      <Button fx:id="loginButton" layoutX="525.0" layoutY="380.0" mnemonicParsing="false" onAction="#loginButtonToHomePage" prefHeight="26.0" prefWidth="200.0" text="Login" />
      <Button fx:id="createAccountButton" layoutX="525.0" layoutY="420.0" mnemonicParsing="false" onAction="#createAccountButtonPressed" prefHeight="26.0" prefWidth="200.0" text="Create Account" />
   </children>
</AnchorPane>
